# Backend (spec: apps/api)
PORT=4000

# PocketBase (run `./pb/pocketbase.exe serve`)
POCKETBASE_URL=http://127.0.0.1:8090
# Optional: browser-facing URL used for screenshot/PDF links (defaults to POCKETBASE_URL)
POCKETBASE_PUBLIC_URL=
POCKETBASE_ADMIN_EMAIL=admin@rostify.local
POCKETBASE_ADMIN_PASSWORD=change-me

GEMINI_API_KEY=xxx
SERPER_API_KEY=xxx
OPENPAGERANK_API_KEY=xxx
WEB_BASE_URL=http://localhost:3000

# Hardening (defaults are production-safe)
# TRUST_PROXY=true            # only behind a reverse proxy / load balancer
# ALLOW_PRIVATE_HOSTS=false   # true lets local dev audit localhost (enables SSRF; never in production)
# MAX_CONCURRENT_AUDITS=2
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW=1 minute
# BODY_LIMIT_BYTES=1048576

# Frontend (spec: apps/web)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
