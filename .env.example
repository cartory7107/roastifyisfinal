# Backend (spec: apps/api)
PORT=4000

# PocketBase (run `./pb/pocketbase.exe serve`)
POCKETBASE_URL=http://127.0.0.1:8090
# Optional: browser-facing URL used for screenshot/PDF links (defaults to POCKETBASE_URL)
POCKETBASE_PUBLIC_URL=
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=change-me

# LLM provider: auto | gemini | ollama | groq
#   auto   -> Gemini free tier first, then Ollama Cloud (paid), then Groq.
#   gemini / ollama / groq -> pin one provider.
LLM_PROVIDER=auto
# GEMINI  -> free tier: AI readiness, niche, content + screenshot review, summary.
#            Key: https://aistudio.google.com/apikey  (free, no card required)
#            Free-tier prompts may be used by Google to improve products.
GEMINI_API_KEY=
# OpenAI-compatible endpoint (default shown).
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# gemini-4-hydrogen is free of charge and multimodal. Alternatives:
# gemini-3.8-flash, gemini-3.1-flash-lite (also free tier).
GEMINI_MODEL=gemini-4-hydrogen
# OLLAMA  -> paid alternative (pay per token, no free tier).
#            Key: https://ollama.com/settings/keys  (pay per token, no free tier)
OLLAMA_API_KEY=
# OpenAI-compatible cloud endpoint (default shown).
OLLAMA_BASE_URL=https://ollama.com/v1
# Cloud model id from https://ollama.com/api/tags (glm-5.3-flash is multimodal).
OLLAMA_MODEL=glm-5.3-flash
# GROQ    -> optional free fallback; same analyses when Ollama is unavailable.
#           Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Default is qwen/qwen3.8-27b (multimodal, JSON mode, 131K context).
GROQ_MODEL=qwen/qwen3.8-27b
# Groq free tier allows 8K tokens/minute. Raise it on a paid Groq plan.
LLM_TOKENS_PER_MINUTE=8000
# SERPER  -> competitor discovery + search-intent (Serper.dev Google search API).
SERPER_API_KEY=
# OPR     -> off-page score / domain authority (openpagerank.com).
OPENPAGERANK_API_KEY=
# SEODATA -> keyword research: monthly volume, CPC, competition (seodata.dev).
#           Optional; a free key gives 50 lookups/day.
SEODATA_API_KEY=
# Market for keyword volumes (two-letter ISO; seodata.dev has no `bd` data -> us).
SEO_KEYWORD_COUNTRY=us
WEB_BASE_URL=http://localhost:3000

# Hardening (defaults are production-safe)
# TRUST_PROXY=true            # only behind a reverse proxy / load balancer
# ALLOW_PRIVATE_HOSTS=false   # true lets local dev audit localhost (enables SSRF; never in production)
# MAX_CONCURRENT_AUDITS=2
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW=1 minute
# BODY_LIMIT_BYTES=1048576

# Frontend (spec: apps/web)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Production (docker compose, see DEPLOY.md)
# ---------------------------------------------------------------------------
# NODE_ENV=production
# CORS_ORIGINS=https://rostify.example.com
# WEB_BASE_URL=http://web:3000            # how the API reaches the PDF print page
# POCKETBASE_PUBLIC_URL=https://pb.rostify.example.com  # browser-facing file host
# NEXT_PUBLIC_API_BASE_URL=https://api.rostify.example.com
# TRUST_PROXY=true
