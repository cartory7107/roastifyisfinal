    "test:crawl": "tsx src/scripts/test-crawl.ts",
    "test:technical": "tsx src/scripts/test-technical.ts",
    "test:onpage": "tsx src/scripts/test-onpage.ts",
    "test:performance": "tsx src/scripts/test-performance.ts",
    "test:content": "tsx src/scripts/test-content.ts",
    "test:offpage": "tsx src/scripts/test-offpage.ts",
    "test:vision": "tsx src/scripts/test-vision.ts",
    "test:synthesizer": "tsx src/scripts/test-synthesizer.ts",
    "test:pdf": "tsx src/scripts/test-pdf.ts",
    "test:niche": "tsx src/scripts/test-niche.ts",
    "test:audit": "tsx src/scripts/test-audit.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@google/genai": "^3.3.0",
    "@rostify/shared": "workspace:^",
    "chrome-launcher": "^1.2.3",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^4.4.1",
    "fastify": "^4.28.1",
    "lighthouse": "^13.6.0",
    "p-limit": "^7.3.3",
    "playwright": "^1.45.3",
    "pocketbase": "^0.26.2",
    "robots-parser": "^3.0.1",
    "zod": "^3.23.8"
