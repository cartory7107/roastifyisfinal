# Production environment for the one-host stack (docker-compose.prod.yml).
#
# Copy this file to `.env` in the repository root on the server, then paste the
# real keys from your local backend/.env. `.env` is gitignored — never commit it.
#
#   cp deploy/.env.example .env
#   nano .env

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# PocketBase
# ---------------------------------------------------------------------------
# Container-internal address. The browser reaches files through the public URL.
POCKETBASE_URL=http://pocketbase:8090
POCKETBASE_PUBLIC_URL=https://roastifys-pb.cartory.top
POCKETBASE_ADMIN_EMAIL=admin@rostify.local
POCKETBASE_ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Public URLs / CORS
# ---------------------------------------------------------------------------
# How the API reaches the PDF print page (internal Docker network).
WEB_BASE_URL=http://web:3000
# Origins allowed to call the API from a browser.
CORS_ORIGINS=https://roastifys.cartory.top,https://*.vercel.app
# Baked into the Next.js bundle at build time (public API host).
NEXT_PUBLIC_API_BASE_URL=https://roastifys-api.cartory.top

# ---------------------------------------------------------------------------
# LLM providers (auto = Gemini free -> Ollama -> Groq)
# ---------------------------------------------------------------------------
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-4-hydrogen
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=glm-5.3-flash
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
LLM_TOKENS_PER_MINUTE=8000

# ---------------------------------------------------------------------------
# Data providers (optional, each one degrades gracefully)
# ---------------------------------------------------------------------------
SERPER_API_KEY=
OPENPAGERANK_API_KEY=
SEODATA_API_KEY=
SEO_KEYWORD_COUNTRY=us

# ---------------------------------------------------------------------------
# Hardening
# ---------------------------------------------------------------------------
TRUST_PROXY=true
ALLOW_PRIVATE_HOSTS=false
MAX_CONCURRENT_AUDITS=2
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=1 minute
BODY_LIMIT_BYTES=1048576
